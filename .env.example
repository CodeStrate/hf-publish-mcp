HF_TOKEN=hf_your_write_scoped_token_here

# Optional: override where jobs and archives are stored (default: ~/.hf_mcp)
# HF_MCP_DIR=/custom/path

# Optional: max completed jobs kept in the active file before archiving (default: 50)
# HF_MCP_MAX_COMPLETED_JOBS=50

# Required for trigger_gguf_quant: log in at https://ggml-org-gguf-my-repo.hf.space,
# then copy the 'session' cookie value from DevTools → Application → Cookies.
# Valid for ~2 weeks; refresh when trigger_gguf_quant starts returning auth errors.
# HF_GGUF_MY_SPACE_COOKIE=your_session_cookie_value 
